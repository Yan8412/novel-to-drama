# ============================================================
#  小说转短剧（novel-to-drama）配置文件示例
#  复制本文件为 .env 并填写你的密钥。.env 已被 .gitignore 忽略，不会提交。
#  所有变量都可以不填：不填时对应的厂商不可用，可用「模拟模式」跑通流程。
# ============================================================

# ---------- 基础 ----------
# 服务监听地址与端口
APP_HOST=127.0.0.1
APP_PORT=8000
# 数据目录（小说、图片、视频都存这里）。默认是项目目录下的 data/。
# Windows 可以写绝对路径，例如 D:\novel-to-drama\data
DATA_DIR=./data
# ffmpeg 可执行文件路径。若 ffmpeg 已在 PATH 中则保持 ffmpeg 即可。
# Windows 示例：D:\tools\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=ffmpeg

# ---------- 厂商选择 ----------
# 每个阶段使用哪个厂商。可选值：
#   LLM_PROVIDER        : mock | deepseek | qwen
#   VISUAL_LLM_PROVIDER : mock | deepseek | qwen   （第二个模型，用于生成分镜/提示词；留空则与 LLM_PROVIDER 相同）
#   IMAGE_PROVIDER      : mock | wanx | jimeng
#   VIDEO_PROVIDER      : mock | kling | jimeng
# mock = 模拟模式，不需要任何密钥，可以完整跑通「小说 -> 剧集视频」流程。
LLM_PROVIDER=mock
VISUAL_LLM_PROVIDER=
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=mock

# ---------- DeepSeek（文本大模型，OpenAI 兼容接口）----------
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- 阿里云百炼 DashScope（通义千问 Qwen 文本 + 通义万相 图片）----------
# 申请地址：https://bailian.console.aliyun.com/?apiKey=1 （「API-KEY 管理」）
# 同一个 DASHSCOPE_API_KEY 同时用于 Qwen 和万相。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
QWEN_MODEL=qwen-plus
# 万相文生图模型：wan2.2-t2i-flash（便宜快）| wan2.2-t2i-plus | wan2.5-t2i-preview | wan2.6-t2i
WANX_MODEL=wan2.2-t2i-flash
# 万相出图尺寸，格式 宽*高（1280*720 适合横屏短剧，720*1280 适合竖屏）
WANX_IMAGE_SIZE=1280*720

# ---------- 火山引擎 即梦 AI（图片 + 视频）----------
# 在火山引擎控制台 -> 访问控制 -> 密钥管理 获取 Access Key / Secret Key，
# 并在「视觉智能 / 即梦 AI」开通「图片生成」「视频生成」服务。
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
VOLC_REGION=cn-north-1
# 即梦文生图 req_key：jimeng_t2i_v40（即梦 4.0）| jimeng_t2i_v31 | jimeng_t2i_v30
JIMENG_T2I_REQ_KEY=jimeng_t2i_v40
# 即梦图生视频 req_key：jimeng_ti2v_v30_pro（3.0 Pro，1080P）| jimeng_i2v_first_v30（3.0，720P）
JIMENG_I2V_REQ_KEY=jimeng_ti2v_v30_pro
# 即梦出图宽高
JIMENG_IMAGE_WIDTH=1280
JIMENG_IMAGE_HEIGHT=720

# ---------- 可灵 Kling（视频）----------
# 申请地址：https://app.klingai.com/cn/dev/document-api  （开放平台 -> 密钥管理）
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# 国内：https://api-beijing.klingai.com ；海外：https://api-singapore.klingai.com
KLING_BASE_URL=https://api-beijing.klingai.com
# 模型：kling-v2-6 | kling-v2-5-turbo | kling-v2-1 | kling-v1-6
KLING_MODEL=kling-v2-6
# std（标准）| pro（高品质，更贵）
KLING_MODE=std

# ---------- 费用提示（仅用于界面估算，不影响调用）----------
# 单张图片 / 单段 5 秒视频的大致单价（人民币），用于生成前的费用预估
COST_PER_IMAGE_CNY=0.2
COST_PER_VIDEO_CLIP_CNY=3.0

# ---------- 轮询 ----------
# 异步任务轮询间隔（秒）与最长等待（秒）
TASK_POLL_INTERVAL=5
TASK_POLL_TIMEOUT=900
